generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  legalName   String    @default("")
  taxId       String    @default("")
  plan        String    @default("Profesional")
  status      String    @default("Activo")
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String   @default("tnx")
  name      String
  code      String
  address   String   @default("")
  city      String   @default("")
  status    String   @default("Activa")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model Subscription {
  id               String    @id @default(cuid())
  tenantId         String    @unique @default("tnx")
  plan             String    @default("Profesional")
  status           String    @default("Activa")
  usersLimit       Int       @default(30)
  driversLimit     Int       @default(80)
  unitsLimit       Int       @default(80)
  storageLimitMb   Int       @default(10240)
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Invitation {
  id         String    @id @default(cuid())
  tenantId   String    @default("tnx")
  code       String
  email      String    @default("")
  phone      String    @default("")
  role       String    @default("chofer")
  status     String    @default("Pendiente")
  expiresAt  DateTime?
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model Device {
  id         String    @id @default(cuid())
  tenantId   String    @default("tnx")
  userId     String?
  driverId   String?
  label      String
  platform   String    @default("PWA")
  pushToken  String?
  status     String    @default("Activo")
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, driverId])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String    @default("tnx")
  userId    String?
  driverId  String?
  channel   String    @default("in-app")
  title     String
  body      String
  status    String    @default("Pendiente")
  priority  String    @default("Media")
  metadata  String    @default("{}")
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([tenantId, status, createdAt])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String   @default("tnx")
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  roleId       String?
  roleRef      Role?    @relation(fields: [roleId], references: [id])
  status       String   @default("Activo")
  phone        String   @default("")
  driverId     String?
  branch       String   @default("Paraná")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, status])
}

model CompanySettings {
  id              String   @id @default("default")
  tenantId        String   @unique @default("tnx")
  name            String   @default("Transporte Nexo")
  legalName       String   @default("Transporte Nexo SRL")
  taxId           String   @default("")
  phone           String   @default("")
  email           String   @default("")
  address         String   @default("")
  branchName      String   @default("Parana")
  country         String   @default("Argentina")
  currency        String   @default("ARS")
  timezone        String   @default("America/Argentina/Buenos_Aires")
  website         String   @default("")
  logoUrl         String?
  primaryColor    String   @default("#0f172a")
  accentColor     String   @default("#2563eb")
  backgroundColor String   @default("#f1f5f9")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ConfigOption {
  id                       String   @id @default(cuid())
  tenantId                 String   @default("tnx")
  kind                     String
  label                    String
  value                    String
  description              String   @default("")
  color                    String   @default("slate")
  sortOrder                Int      @default(0)
  active                   Boolean  @default(true)
  requiresDoubleValidation Boolean  @default(false)
  blocksOperation          Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([kind, value])
  @@index([tenantId, kind, sortOrder])
  @@index([kind, sortOrder])
}

model OperationalRule {
  id               String   @id @default(cuid())
  tenantId         String   @default("tnx")
  code             String   @unique
  name             String
  description      String
  appliesTo        String   @default("Viajes")
  trigger          String
  action           String
  severity         String   @default("Media")
  enabled          Boolean  @default(true)
  requiresAdmin    Boolean  @default(false)
  doubleValidation Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String           @unique
  description String
  level       Int              @default(1)
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  action      String
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String   @default("tnx")
  actorName String   @default("Sistema")
  actorRole String   @default("ADMIN")
  entity    String
  entityId  String
  action    String
  detail    String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId, createdAt])
}

model Driver {
  id             String         @id @default(cuid())
  tenantId       String         @default("tnx")
  slug           String         @unique
  name           String
  initials       String
  status         String
  category       String
  phone          String
  dni            String         @unique
  license        String
  licenseRisk    Boolean        @default(false)
  tripsThisMonth Int            @default(0)
  punctuality    Int            @default(0)
  incidents      Int            @default(0)
  lastActivity   String         @default("Sin actividad")
  unitId         String?        @unique
  unit           Unit?          @relation("DriverUnit", fields: [unitId], references: [id])
  trips          Trip[]
  movements      CashMovement[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId, status])
}

model Unit {
  id             String           @id @default(cuid())
  tenantId       String           @default("tnx")
  brand          String
  model          String
  plate          String           @unique
  status         String
  base           String
  km             Int              @default(0)
  docs           String           @default("[]")
  technicalNotes String           @default("[]")
  serviceDue     String           @default("Sin programar")
  hasRisk        Boolean          @default(false)
  assignedDriver Driver?          @relation("DriverUnit")
  trips          Trip[]
  movements      CashMovement[]
  maintenance    MaintenanceJob[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([tenantId, status])
}

model Client {
  id             String          @id @default(cuid())
  tenantId       String          @default("tnx")
  code           String          @unique
  slug           String          @unique
  name           String
  contact        String
  phone          String
  reception      String
  tripsThisMonth Int             @default(0)
  status         String
  requiresTurn   Boolean         @default(false)
  tags           String          @default("[]")
  requirements   String          @default("[]")
  delayAverage   String          @default("0m")
  openIncidents  Int             @default(0)
  mainTrips      Trip[]          @relation("MainClientTrips")
  tripClients    TripClient[]
  stops          TripStop[]
  orders         LoadOrder[]
  histories      ClientHistory[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenantId, status])
}

model ClientHistory {
  id        String   @id @default(cuid())
  event     String
  detail    String
  snapshot  String   @default("{}")
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model Trip {
  id            String                    @id @default(cuid())
  tenantId      String                    @default("tnx")
  code          String                    @unique
  slug          String                    @unique
  origin        String
  destination   String
  status        String
  alert         String                    @default("Sin alertas")
  date          DateTime
  assignedCash  Int                       @default(0)
  spentCash     Int                       @default(0)
  mainClientId  String
  mainClient    Client                    @relation("MainClientTrips", fields: [mainClientId], references: [id])
  driverId      String?
  driver        Driver?                   @relation(fields: [driverId], references: [id])
  unitId        String?
  unit          Unit?                     @relation(fields: [unitId], references: [id])
  clients       TripClient[]
  stops         TripStop[]
  timeline      TripTimeline[]
  movements     CashMovement[]
  documents     Document[]
  confirmations OperationalConfirmation[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([tenantId, status, date])
}

model OperationalConfirmation {
  id            String    @id @default(cuid())
  code          String
  label         String
  status        String    @default("Pendiente")
  requestedBy   String    @default("Chofer")
  requestedRole String    @default("Chofer")
  confirmedBy   String?
  confirmedRole String?
  notes         String    @default("")
  tripId        String
  trip          Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  confirmedAt   DateTime?

  @@index([tripId, status])
}

model TripClient {
  tripId   String
  clientId String
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([tripId, clientId])
}

model TripStop {
  id           String  @id @default(cuid())
  number       Int
  clientCode   String  @default("")
  clientName   String  @default("")
  contact      String  @default("")
  reception    String  @default("")
  requiresTurn Boolean @default(false)
  turnStatus   String  @default("No requiere turno")
  address      String
  goods        String
  status       String
  note         String
  delivered    Boolean @default(false)
  alert        String?
  returnInfo   String?
  tripId       String
  trip         Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client  @relation(fields: [clientId], references: [id])

  @@unique([tripId, number])
}

model TripTimeline {
  id     String @id @default(cuid())
  time   String
  text   String
  state  String
  order  Int
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model LoadOrder {
  id          String   @id @default(cuid())
  tenantId    String   @default("tnx")
  code        String   @unique
  slug        String   @unique
  load        String
  origin      String
  destination String
  status      String
  docs        String
  risk        Boolean  @default(false)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  driverId    String?
  unitId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id          String   @id
  tenantId    String   @default("tnx")
  name        String
  owner       String
  association String
  type        String
  due         String
  status      String
  fileUrl     String?
  tripId      String?
  trip        Trip?    @relation(fields: [tripId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Incident {
  id        String   @id
  tenantId  String   @default("tnx")
  type      String
  title     String
  detail    String
  tone      String
  status    String   @default("Abierta")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CashMovement {
  id        String   @id
  tenantId  String   @default("tnx")
  date      DateTime
  type      String
  category  String
  amount    Int
  status    String
  risk      Boolean  @default(false)
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])
  unitId    String?
  unit      Unit?    @relation(fields: [unitId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaintenanceJob {
  id        String   @id
  tenantId  String   @default("tnx")
  issue     String
  status    String
  next      String
  risk      Boolean  @default(false)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
